// 영웅 도감 데이터 모델 (docs/PLAN.md 3장, docs/HERO_MAKER.md 6장)
// 런타임 연결은 src/lib/db.ts(드라이버 어댑터), 마이그레이션 연결은 prisma.config.ts에서 설정합니다.
//
// 공식 데이터 vs 가족 데이터
// - familyId가 null이면 공식 세계관/인물(모든 가족이 봄)
// - familyId가 있으면 그 가족만 봄 (src/lib/queries/visibility.ts의 공통 조건으로만 조회)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 가족: 부모 계정(Neon Auth 사용자) 하나가 가족 하나를 가집니다.
model Family {
  id            String                   @id @default(cuid())
  /// neon_auth 사용자 id
  ownerId       String                   @unique
  /// 부모 모드 PIN (scrypt 해시)
  parentPinHash String
  createdAt     DateTime                 @default(now())
  profiles      ChildProfile[]
  series        Series[]
  characters    Character[]
  pictures      FamilyCharacterPicture[]
  battles       BattleRecord[]
}

/// 아이 프로필: 별명과 아바타만 저장합니다 (개인정보 없음).
model ChildProfile {
  id          String                   @id @default(cuid())
  familyId    String
  family      Family                   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  nickname    String
  /// 미리 준비된 아바타 키 (src/lib/family/avatars.ts)
  avatar      String
  order       Int                      @default(0)
  createdAt   DateTime                 @default(now())
  characters  Character[]              @relation("creator")
  series      Series[]                 @relation("seriesCreator")
  pictures    FamilyCharacterPicture[]
  battlesAsP1 BattleRecord[]           @relation("battleP1")
  battlesAsP2 BattleRecord[]           @relation("battleP2")

  @@index([familyId, order])
}

/// 세계관: 그리스신화, 삼국지, 수호지, 초한지 … + 가족이 만든 세계관
model Series {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String
  coverImage  String?
  themeColor  String?
  /// 능력치 라벨: {"stat1":"통솔","stat2":"무력","stat3":"지력","stat4":"정치","stat5":"매력"}
  statLabels  Json
  order       Int             @default(0)
  /// null이면 공식 세계관
  familyId    String?
  family      Family?         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId   String?
  creator     ChildProfile?   @relation("seriesCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  /// 꾸미기 기본 파츠 팩
  partsPack   String          @default("general")
  factions    Faction[]
  kinds       CharacterKind[]
  characters  Character[]

  @@index([familyId, order])
}

/// 진영/소속: 촉·위·오, 올림포스, 양산박 …
model Faction {
  id         String      @id @default(cuid())
  seriesId   String
  series     Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name       String
  /// 카드 일러스트 영역 배경색 (docs/DESIGN.md 2장)
  color      String?
  emblem     String?
  characters Character[]

  @@unique([seriesId, name])
}

/// 세계관별 종류: 장수/책사/군주, 신/영웅/괴물, 티니핑/로열 티니핑 …
model CharacterKind {
  id         String      @id @default(cuid())
  seriesId   String
  series     Series      @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  name       String
  order      Int         @default(0)
  /// 카드 배경색 (편이 없는 세계관에서 씀. 편 색이 있으면 편 색이 먼저)
  color      String?
  characters Character[]

  @@unique([seriesId, name])
}

enum CreationStatus {
  DRAFT
  DONE
}

model Character {
  id        String         @id @default(cuid())
  slug      String         @unique
  seriesId  String
  series    Series         @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  factionId String?
  faction   Faction?       @relation(fields: [factionId], references: [id], onDelete: SetNull)
  kindId    String?
  kind      CharacterKind? @relation(fields: [kindId], references: [id], onDelete: SetNull)

  name         String
  originalName String?
  title        String?
  aliases      String[]
  /// 이름 + 별칭 + 칭호 (서버에서 생성)
  searchText   String
  /// 초성 (서버에서 생성)
  choseong     String

  /// 1~5성
  rarity Int @default(1)
  /// 능력치 5칸. 이름은 Series.statLabels에서 가져옵니다.
  stat1  Int @default(0)
  stat2  Int @default(0)
  stat3  Int @default(0)
  stat4  Int @default(0)
  stat5  Int @default(0)

  summary   String
  /// 인물 열전 (빈 줄로 문단 구분)
  biography String
  funFacts  String[]
  /// 공식 인물: 이미지 URL / 아이가 만든 영웅: 그림 PNG의 저장소 키
  imageUrl  String?
  thumbUrl  String?
  era       String?

  /// null이면 공식 인물
  familyId      String?
  family        Family?        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId     String?
  creator       ChildProfile?  @relation("creator", fields: [creatorId], references: [id], onDelete: SetNull)
  status        CreationStatus @default(DONE)
  /// 영웅 마법사에서 이어서 만들기용
  wizardStep    Int            @default(0)
  /// 부모가 숨김
  hidden        Boolean        @default(false)
  /// 꾸미기 파츠 조합
  avatarParts   Json?
  /// 그리기 획 데이터 JSON의 저장소 키 (Object Storage `drawings` 버킷)
  strokesUrl    String?
  /// 카드 배틀 특별한 힘 (아이가 고름). null이면 종류에서 (공식 세계관), "none"이면 없음
  ability       String?
  /// 밑그림 사진(JPEG)의 저장소 키. 사진 위에 덧그린 그림이 imageUrl입니다.
  backgroundUrl String?
  /// 영웅 마법사 입력값 (이야기 빈칸 답 등). 다시 고칠 때 채워 넣기 위해 보관합니다.
  wizardData    Json?

  tags           CharacterTag[]
  /// 공식 인물에 가족이 붙인 그림 (가족마다 따로)
  familyPictures FamilyCharacterPicture[]
  relationsFrom  Relation[]               @relation("from")
  relationsTo    Relation[]               @relation("to")

  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([seriesId, factionId, kindId])
  @@index([seriesId, name, id])
  @@index([seriesId, stat1(sort: Desc), id])
  @@index([seriesId, stat2(sort: Desc), id])
  @@index([seriesId, stat3(sort: Desc), id])
  @@index([seriesId, stat4(sort: Desc), id])
  @@index([seriesId, stat5(sort: Desc), id])
  @@index([familyId, creatorId, status, updatedAt])
  /// 부분 일치 검색(ILIKE '%관%')용 trigram 인덱스. pg_trgm 확장이 필요합니다(마이그레이션에서 생성).
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Character_searchText_trgm_idx")
  @@index([choseong(ops: raw("gin_trgm_ops"))], type: Gin, map: "Character_choseong_trgm_idx")
}

/// 특기: 궁술, 지략, 바다, 변신 …
model Tag {
  id         String         @id @default(cuid())
  name       String         @unique
  characters CharacterTag[]
}

model CharacterTag {
  characterId String
  tagId       String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([characterId, tagId])
}

enum RelationType {
  PARENT
  CHILD
  SPOUSE
  SIBLING
  SWORN_BROTHER
  LORD
  SUBORDINATE
  RIVAL
  MENTOR
}

/// Relation(from, to, type): "to는 from의 type"
model Relation {
  id     String       @id @default(cuid())
  fromId String
  toId   String
  type   RelationType
  note   String?
  from   Character    @relation("from", fields: [fromId], references: [id], onDelete: Cascade)
  to     Character    @relation("to", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, type])
}

/// 공식 인물에 가족이 붙인 그림. 그 가족에게만 보입니다 (공식 인물 데이터는 모든 가족이 같이 씀).
model FamilyCharacterPicture {
  id            String        @id @default(cuid())
  familyId      String
  family        Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  characterId   String
  character     Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// 마지막으로 그림을 바꾼 아이 (부모가 바꿨거나 프로필을 지웠으면 null)
  updatedById   String?
  updatedBy     ChildProfile? @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  /// 완성 그림(PNG 또는 JPEG), 그리기 기록 JSON, 밑그림 사진의 저장소 키
  imageUrl      String
  strokesUrl    String?
  backgroundUrl String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([familyId, characterId])
  @@index([characterId])
}

/// 카드 배틀 결과 (가족 안 전적). 토리와 한 판은 p2Id가 null.
model BattleRecord {
  id        String        @id @default(cuid())
  familyId  String
  family    Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  /// 먼저 고른 아이 (토리 대결이면 그 아이)
  p1Id      String?
  p1        ChildProfile? @relation("battleP1", fields: [p1Id], references: [id], onDelete: SetNull)
  /// 둘이 대결의 상대 아이 (null이면 토리)
  p2Id      String?
  p2        ChildProfile? @relation("battleP2", fields: [p2Id], references: [id], onDelete: SetNull)
  vsTori    Boolean
  /// 이긴 쪽: 1 또는 2
  winner    Int
  /// 대장 이름 (기록용, 인물이 지워져도 남게 이름으로)
  p1Leader  String
  p2Leader  String
  /// 두 사람 차례 수 합
  turns     Int
  createdAt DateTime      @default(now())

  @@index([familyId, createdAt])
}
